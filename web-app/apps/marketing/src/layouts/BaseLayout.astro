---
import '@acepharm/design-tokens/tokens.css';
import '../styles/global.css';
import { CookieConsentBanner } from '@acepharm/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'AcePharm — Created by pharmacists. Built for pharmacy students.',
  description = 'A revision platform designed exclusively for UK MPharm students, foundation trainees, and GPhC candidates.',
  canonicalUrl = Astro.url.href,
  ogImage = 'https://acepharmexams.co.uk/og-image.png',
  ogType = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph / Facebook / LinkedIn */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="AcePharm" />
    <meta property="og:locale" content="en_GB" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    
    {/* Global Structured Data (Organization, EducationalOccupationalProgram, AggregateRating) */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://acepharmexams.co.uk/#organization',
          name: 'AcePharm',
          url: 'https://acepharmexams.co.uk',
          logo: {
            '@type': 'ImageObject',
            url: 'https://acepharmexams.co.uk/logo.png',
            width: 512,
            height: 512,
          },
          description: 'Educational revision platform designed exclusively for UK pharmacy students, foundation trainees, and GPhC registration candidates.',
          knowsAbout: [
            'GPhC Registration Assessment',
            'MPharm Degree Curriculum',
            'Clinical Pharmacology & Therapeutics',
            'Pharmaceutical Calculations (Paper 1)',
            'Medicines Ethics and Practice (MEP)',
            'British National Formulary (BNF)',
            'NICE Clinical Guidelines'
          ]
        },
        {
          '@type': 'EducationalOccupationalProgram',
          '@id': 'https://acepharmexams.co.uk/#program',
          name: 'AcePharm GPhC & MPharm Pharmacy Assessment Preparation',
          description: 'Comprehensive curriculum-aligned preparation program for UK pharmacy students, foundation trainees, and GPhC candidates covering high-yield therapeutics, calculations, and law.',
          provider: {
            '@id': 'https://acepharmexams.co.uk/#organization'
          },
          educationalCredentialAwarded: 'GPhC Registration Assessment Readiness',
          occupationalCategory: '2213: Pharmacists',
          programPrerequisites: 'Enrolled in UK MPharm degree, OSPAP, or GPhC Foundation Training Year',
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: '4.9',
            bestRating: '5',
            worstRating: '1',
            ratingCount: '342',
            reviewCount: '286'
          }
        },
        {
          '@type': 'WebSite',
          '@id': 'https://acepharmexams.co.uk/#website',
          url: 'https://acepharmexams.co.uk',
          name: 'AcePharm',
          description: 'Created by pharmacists. Built for pharmacy students.',
          publisher: {
            '@id': 'https://acepharmexams.co.uk/#organization'
          },
          inLanguage: 'en-GB'
        }
      ]
    })} />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased min-h-screen flex flex-col selection:bg-indigo-wash selection:text-indigo">
    <Header currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      import { tracker } from '@acepharm/ui';
      // Initialize tracker on page load
      tracker.init({
        cloudflareWebAnalyticsToken: import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN,
      });
    </script>
    <CookieConsentBanner client:idle />
  </body>
</html>
