---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PricingToggle, Card, FaqAccordion } from '@acepharm/ui';
import PlanComparisonMatrix from '../components/PlanComparisonMatrix';
---

<BaseLayout
  title="Pricing — AcePharm"
  description="Simple pricing. Full access when you need it. No complicated bundles and no hidden feature tiers."
>
  {/* Product & Offer JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'AcePharm Revision Platform',
    description: 'Comprehensive pharmacy revision platform with clinical questions, calculations, and AI tutoring.',
    brand: {
      '@type': 'Brand',
      name: 'AcePharm'
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'AcePharm Monthly Revision Plan',
        description: 'Full question bank access, calculation step-by-step guides, confidence calibration and unlimited Ace AI tutoring.',
        price: '4.99',
        priceCurrency: 'GBP',
        availability: 'https://schema.org/InStock',
        url: 'https://acepharmexams.co.uk/pricing',
        category: 'EducationalSoftware'
      },
      {
        '@type': 'Offer',
        name: 'AcePharm Annual Revision Plan',
        description: '12 months complete access including full GPhC Mock Exam modes and high-yield therapeutic breakdowns.',
        price: '49.99',
        priceCurrency: 'GBP',
        availability: 'https://schema.org/InStock',
        url: 'https://acepharmexams.co.uk/pricing',
        category: 'EducationalSoftware'
      }
    ]
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4" style="background-image: url('/assets/backgrounds/hero-gradient.svg'); background-size: cover; background-position: center;">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Transparent Revision Pricing
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Simple pricing. Full access when you need it.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Premium revision without premium-student pricing. No complicated bundles and no hidden feature tiers.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4">
    {/* Interactive Island for Pricing */}
    <PricingToggle client:visible />

    {/* Plan Comparison Matrix Table */}
    <PlanComparisonMatrix client:visible />

    {/* Section 6: Pricing FAQ */}
    <div class="mt-24 pt-16 border-t border-border">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Common Questions</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-2">Pricing FAQ</h2>
        <p class="mt-2 text-xs sm:text-sm text-slate">Clear answers on subscriptions, renewals, and product access.</p>
      </div>
      <div class="max-w-3xl mx-auto">
        <FaqAccordion
          client:visible
          groups={[
            {
              category: 'Subscription & Billing',
              items: [
                {
                  question: 'Are the plans different?',
                  answer: 'Monthly and yearly subscribers receive the same product access. The only difference is billing frequency and price.',
                },
                {
                  question: 'Is there a trial?',
                  answer: 'Students can explore a limited selection of questions before subscribing. This provides a more useful demonstration than a short trial that may expire before revision begins.',
                },
                {
                  question: 'Will my subscription renew automatically?',
                  answer: 'Yes, unless cancelled. The renewal date and amount are displayed before purchase and in your account.',
                },
                {
                  question: 'What happens when I cancel?',
                  answer: 'Access continues until the end of the current paid period. Your account and learning history remain available, although paid content becomes locked.',
                },
              ],
            },
          ]}
        />
      </div>
    </div>

    {/* Roadmap & Institutional Pilot Programmes */}
    <div class="mt-24 pt-16 border-t border-border">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-bold uppercase tracking-wider border border-indigo/20 mb-3">
          Roadmap & Partnerships
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink">Institutional & Group Programmes</h2>
        <p class="mt-3 text-xs sm:text-sm text-slate leading-relaxed">
          Individual subscriptions above provide immediate self-directed access. We are also introducing pilot programmes for pharmacy faculties, foundation training trusts, and student associations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {/* Student & Trainee Society Pilots */}
        <div class="bg-surface border border-border rounded-card p-8 flex flex-col justify-between shadow-xs hover:border-indigo/40 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full bg-indigo-wash text-indigo text-[11px] font-bold border border-indigo/20">Roadmap Pilot</span>
              <span class="text-xs text-slate font-medium">BPSA & Student Societies</span>
            </div>
            <h3 class="text-lg font-bold text-ink">Student & Trainee Discount</h3>
            <p class="mt-3 text-xs sm:text-sm text-slate leading-relaxed">
              We are partnering with MPharm student societies and BPSA branches for discounted group cohorts and peer study packs. If your university student association or foundation trainee group would like to pilot cohort access:
            </p>
            <ul class="mt-5 space-y-2.5 text-xs text-slate">
              <li class="flex items-center gap-2">
                <span class="text-indigo font-bold">✓</span>
                <span>Group access terms for pharmacy student societies</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-indigo font-bold">✓</span>
                <span>Coordinated onboarding for university year groups</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-indigo font-bold">✓</span>
                <span>Tailored study session materials & guidance</span>
              </li>
            </ul>
          </div>
          <div class="mt-8 pt-6 border-t border-border">
            <a
              href="/contact?category=University%20/%20Institution%20Partnership&subject=society"
              class="inline-flex items-center justify-center w-full rounded-btn bg-surface border border-border px-5 py-2.5 text-xs sm:text-sm font-semibold text-ink hover:border-indigo hover:text-indigo hover:bg-indigo-wash/30 transition-all shadow-xs"
            >
              Speak with cohort team →
            </a>
          </div>
        </div>

        {/* University & Foundation Cohort Licences */}
        <div class="bg-surface border border-border rounded-card p-8 flex flex-col justify-between shadow-xs hover:border-indigo/40 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full bg-teal-light text-teal text-[11px] font-bold border border-teal/20">Institutional Pilot</span>
              <span class="text-xs text-slate font-medium">Universities & NHS Trusts</span>
            </div>
            <h3 class="text-lg font-bold text-ink">University & Cohort Access</h3>
            <p class="mt-3 text-xs sm:text-sm text-slate leading-relaxed">
              Are you an MPharm course leader, academic tutor, or NHS training provider? We provide institution-wide cohort licensing, curriculum mapping support, and custom diagnostic cohorts.
            </p>
            <ul class="mt-5 space-y-2.5 text-xs text-slate">
              <li class="flex items-center gap-2">
                <span class="text-teal font-bold">✓</span>
                <span>Cohort-wide diagnostic tracking & analytics</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-teal font-bold">✓</span>
                <span>GPhC registration assessment blueprint mapping</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-teal font-bold">✓</span>
                <span>Dedicated institutional onboarding & pilot support</span>
              </li>
            </ul>
          </div>
          <div class="mt-8 pt-6 border-t border-border">
            <a
              href="/contact?category=University%20/%20Institution%20Partnership&subject=institutional"
              class="inline-flex items-center justify-center w-full rounded-btn bg-surface border border-border px-5 py-2.5 text-xs sm:text-sm font-semibold text-ink hover:border-indigo hover:text-indigo hover:bg-indigo-wash/30 transition-all shadow-xs"
            >
              Speak with cohort team →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
