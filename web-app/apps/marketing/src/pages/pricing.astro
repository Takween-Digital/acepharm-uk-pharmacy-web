---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PricingToggle, Card, FaqAccordion } from '@acepharm/ui';
import PlanComparisonMatrix from '../components/PlanComparisonMatrix';
---

<BaseLayout
  title="Pricing — AcePharm"
  description="Simple pricing. Full access when you need it. No complicated bundles and no hidden feature tiers."
>
  {/* Product & Offer JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'AcePharm Revision Platform',
    description: 'Comprehensive pharmacy revision platform with clinical questions, calculations, and AI tutoring.',
    brand: {
      '@type': 'Brand',
      name: 'AcePharm'
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'AcePharm Monthly Revision Plan',
        description: 'Full question bank access, calculation step-by-step guides, confidence calibration and unlimited Ace AI tutoring.',
        price: '4.99',
        priceCurrency: 'GBP',
        availability: 'https://schema.org/InStock',
        url: 'https://acepharmexams.co.uk/pricing',
        category: 'EducationalSoftware'
      },
      {
        '@type': 'Offer',
        name: 'AcePharm Annual Revision Plan',
        description: '12 months complete access including full GPhC Mock Exam modes and high-yield therapeutic breakdowns.',
        price: '49.99',
        priceCurrency: 'GBP',
        availability: 'https://schema.org/InStock',
        url: 'https://acepharmexams.co.uk/pricing',
        category: 'EducationalSoftware'
      }
    ]
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4" style="background-image: url('/assets/backgrounds/hero-gradient.svg'); background-size: cover; background-position: center;">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Transparent Revision Pricing
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Simple pricing. Full access when you need it.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Premium revision without premium-student pricing. No complicated bundles and no hidden feature tiers.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4">
    {/* Interactive Island for Pricing */}
    <PricingToggle client:visible />

    {/* Plan Comparison Matrix Table */}
    <PlanComparisonMatrix client:visible />

    {/* Section 6: Pricing FAQ */}
    <div class="mt-24 pt-16 border-t border-border">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Common Questions</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-2">Pricing FAQ</h2>
        <p class="mt-2 text-xs sm:text-sm text-slate">Clear answers on subscriptions, renewals, and product access.</p>
      </div>
      <div class="max-w-3xl mx-auto">
        <FaqAccordion
          client:visible
          groups={[
            {
              category: 'Subscription & Billing',
              items: [
                {
                  question: 'Are the plans different?',
                  answer: 'Monthly and yearly subscribers receive the same product access. The only difference is billing frequency and price.',
                },
                {
                  question: 'Is there a trial?',
                  answer: 'Students can explore a limited selection of questions before subscribing. This provides a more useful demonstration than a short trial that may expire before revision begins.',
                },
                {
                  question: 'Will my subscription renew automatically?',
                  answer: 'Yes, unless cancelled. The renewal date and amount are displayed before purchase and in your account.',
                },
                {
                  question: 'What happens when I cancel?',
                  answer: 'Access continues until the end of the current paid period. Your account and learning history remain available, although paid content becomes locked.',
                },
              ],
            },
          ]}
        />
      </div>
    </div>

  </section>
</BaseLayout>
