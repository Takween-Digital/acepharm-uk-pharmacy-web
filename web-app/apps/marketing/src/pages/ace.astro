---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Card } from '@acepharm/ui';
---

<BaseLayout
  title="Ace — Your Clinical Revision Tutor"
  description="A tutor that knows the content, knows your history, and can only answer from material a pharmacist has signed off."
>
  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4" style="background-image: url('/assets/backgrounds/hero-gradient.svg'); background-size: cover; background-position: center;">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Clinical AI Grounding
        </span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink">
        Ace
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        A tutor that knows the content, knows your history, and can only answer from material a pharmacist has signed off.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="https://app.acepharmexams.co.uk/session/new">
          <Button size="lg" variant="primary">Try Ace on a real question</Button>
        </a>
      </div>
      <p class="mt-3 text-xs text-slate-light">No account needed for the free sample.</p>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4 space-y-16">
    {/* Six Core Principles */}
    <div>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Safety & Governance</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-2">Six Core Principles</h2>
        <p class="mt-2 text-xs sm:text-sm text-slate">How Ace is engineered to protect clinical safety and accuracy.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card className="p-6 bg-surface border border-border rounded-card shadow-xs hover:border-indigo/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo uppercase tracking-wider">Principle 1</span>
            <h3 class="font-bold text-ink mt-1 mb-2 text-sm">Grounded strictly in reviewed content</h3>
            <p class="text-xs text-slate leading-relaxed">Ace only answers from verified AcePharm subtopic notes, explanations and UK guidelines. It never invents clinical facts from general web data.</p>
          </div>
        </Card>

        <Card className="p-6 bg-surface border border-border rounded-card shadow-xs hover:border-indigo/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo uppercase tracking-wider">Principle 2</span>
            <h3 class="font-bold text-ink mt-1 mb-2 text-sm">Always cites where points come from</h3>
            <p class="text-xs text-slate leading-relaxed">Every response displays direct citations linking back to the verified database chunk, BNF chapter, or guideline paragraph used to answer.</p>
          </div>
        </Card>

        <Card className="p-6 bg-surface border border-border rounded-card shadow-xs hover:border-indigo/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo uppercase tracking-wider">Principle 3</span>
            <h3 class="font-bold text-ink mt-1 mb-2 text-sm">Never gives patient-specific advice</h3>
            <p class="text-xs text-slate leading-relaxed">Ace is built strictly for student education. Enquiries about live personal treatment or emergencies are immediately directed to the BNF and emergency services.</p>
          </div>
        </Card>

        <Card className="p-6 bg-surface border border-border rounded-card shadow-xs hover:border-indigo/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo uppercase tracking-wider">Principle 4</span>
            <h3 class="font-bold text-ink mt-1 mb-2 text-sm">Thread-scoped and context-aware</h3>
            <p class="text-xs text-slate leading-relaxed">Ace knows exactly which question, options and explanation you are currently viewing, allowing natural conversational follow-ups.</p>
          </div>
        </Card>

        <Card className="p-6 bg-surface border border-border rounded-card shadow-xs hover:border-indigo/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo uppercase tracking-wider">Principle 5</span>
            <h3 class="font-bold text-ink mt-1 mb-2 text-sm">Feeds the editorial queue</h3>
            <p class="text-xs text-slate leading-relaxed">Reporting an Ace response routes directly into the clinical review queue, ensuring continuous supervision by UK pharmacists.</p>
          </div>
        </Card>

        <Card className="p-6 bg-surface border border-border rounded-card shadow-xs hover:border-indigo/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo uppercase tracking-wider">Principle 6</span>
            <h3 class="font-bold text-ink mt-1 mb-2 text-sm">Never marks its own homework</h3>
            <p class="text-xs text-slate leading-relaxed">AI-drafted question content is always reviewed and verified by human pharmacists before publication.</p>
          </div>
        </Card>
      </div>
    </div>

    {/* What you can ask Ace */}
    <div class="p-8 bg-surface rounded-card border border-border shadow-xs">
      <div class="max-w-2xl mb-6">
        <h2 class="text-xl font-bold text-ink">What you can ask Ace</h2>
        <p class="text-xs text-slate mt-1">Prompt Ace directly beside any clinical scenario or calculation.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="p-4 bg-canvas rounded-card border border-border font-medium text-ink flex items-center gap-2.5">
          <span class="text-indigo font-bold">💬</span>
          <span>“Make this explanation simpler”</span>
        </div>
        <div class="p-4 bg-canvas rounded-card border border-border font-medium text-ink flex items-center gap-2.5">
          <span class="text-indigo font-bold">💬</span>
          <span>“Why is Option C wrong in this scenario?”</span>
        </div>
        <div class="p-4 bg-canvas rounded-card border border-border font-medium text-ink flex items-center gap-2.5">
          <span class="text-indigo font-bold">💬</span>
          <span>“Give me a similar GPhC exam practice scenario”</span>
        </div>
        <div class="p-4 bg-canvas rounded-card border border-border font-medium text-ink flex items-center gap-2.5">
          <span class="text-indigo font-bold">💬</span>
          <span>“Show me step-by-step working for this calculation”</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
