---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Card } from '@acepharm/ui';
import InteractiveSampleQuestion from '../components/InteractiveSampleQuestion';
import SyllabusCategoryExplorer from '../components/SyllabusCategoryExplorer';
---

<BaseLayout
  title="Question Bank — AcePharm"
  description="A pharmacy question bank built around understanding. Every question should help you recognise an important principle, avoid a common error or make a safer clinical decision."
>
  {/* EducationalOccupationalCredential / Course Schema for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'AcePharm UK MPharm & GPhC Pharmacy Question Bank',
    description: 'Comprehensive curriculum-mapped pharmacy question bank covering clinical therapeutics, pharmaceutical calculations, and pharmacy law.',
    provider: {
      '@type': 'Organization',
      name: 'AcePharm',
      sameAs: 'https://acepharmexams.co.uk'
    },
    educationalCredentialAwarded: 'GPhC Registration Assessment Preparation',
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'Online',
      courseWorkload: 'PT30M'
    }
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4" style="background-image: url('/assets/backgrounds/hero-gradient.svg'); background-size: cover; background-position: center;">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          UK Curriculum-Mapped Question Bank
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        A pharmacy question bank built around understanding.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Every question should help you recognise an important principle, avoid a common error or make a safer clinical decision.
      </p>

      {/* Live Interactive Sample Question Micro-Demo Island */}
      <div class="mt-12">
        <InteractiveSampleQuestion client:visible />
      </div>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4 space-y-16">
    {/* Pathways */}
    <div>
      <h2 class="text-2xl font-bold text-ink mb-6">Choose your pathway</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <Card className="p-5 bg-surface border-2 border-indigo rounded-card shadow-sm hover:shadow-card hover:border-indigo-deep transition-all group">
          <span class="px-2.5 py-0.5 rounded-full bg-teal text-white text-xs font-bold border border-teal/40">Active</span>
          <h3 class="font-bold text-ink text-base mt-2 group-hover:text-indigo transition-colors">MPharm revision</h3>
          <p class="text-xs text-slate mt-1">High-yield clinical topics, therapeutics, calculations and law for years 2 to 4.</p>
        </Card>
        <Card className="p-5 bg-canvas border border-border rounded-card hover:bg-surface hover:border-border/60 transition-all group">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-lighter text-slate text-xs font-medium border border-slate-lighter/60">Coming later</span>
          <h3 class="font-bold text-slate-deep text-base mt-2 group-hover:text-ink transition-colors">Foundation training</h3>
          <p class="text-xs text-slate-light mt-1">Practice-based scenarios, calculations and clinical governance for trainees.</p>
        </Card>
        <Card className="p-5 bg-canvas border border-border rounded-card hover:bg-surface hover:border-border/60 transition-all group">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-lighter text-slate text-xs font-medium border border-slate-lighter/60">Coming later</span>
          <h3 class="font-bold text-slate-deep text-base mt-2 group-hover:text-ink transition-colors">Registration Assessment</h3>
          <p class="text-xs text-slate-light mt-1">Simulated full-length Paper 1 and Paper 2 mock exam experiences.</p>
        </Card>
        <Card className="p-5 bg-canvas border border-border rounded-card hover:bg-surface hover:border-border/60 transition-all group">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-lighter text-slate text-xs font-medium border border-slate-lighter/60">Coming later</span>
          <h3 class="font-bold text-slate-deep text-base mt-2 group-hover:text-ink transition-colors">Oriel preparation</h3>
          <p class="text-xs text-slate-light mt-1">Situational judgement tests and clinical prioritisation questions.</p>
        </Card>
        <Card className="p-5 bg-canvas border border-border rounded-card hover:bg-surface hover:border-border/60 transition-all group">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-lighter text-slate text-xs font-medium border border-slate-lighter/60">Coming later</span>
          <h3 class="font-bold text-slate-deep text-base mt-2 group-hover:text-ink transition-colors">Independent Prescribing</h3>
          <p class="text-xs text-slate-light mt-1">Advanced therapeutics, differential diagnosis and prescribing safety.</p>
        </Card>
      </div>
    </div>

    {/* Question Bank Browser & Syllabus Explorer */}
    <div>
      <div class="mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Topic Browser</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-1">Question bank browser</h2>
        <p class="text-xs sm:text-sm text-slate mt-2 max-w-3xl leading-relaxed">
          See exactly how many questions are available in each topic before you start a session. Build a session from any combination of topics, or let AcePharm select a balanced mixture for you.
        </p>
      </div>

      <SyllabusCategoryExplorer client:visible />

      <div class="mt-6 p-4 rounded-card bg-indigo-wash/40 border border-indigo/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-slate">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-medium text-ink">Published questions pass clinical, educational and editorial review before becoming available to learners.</span>
        </div>
        <a href="/editorial-standards" class="text-indigo hover:text-indigo-deep font-semibold whitespace-nowrap text-xs underline">
          Our editorial standards →
        </a>
      </div>
    </div>

    {/* Modes */}
    <div>
      <div class="mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Flexible Study Formats</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mt-1">Choose your mode</h2>
        <p class="text-xs sm:text-sm text-slate mt-2 max-w-2xl leading-relaxed">
          Select from 8 purpose-built study modes to match your learning goals, from rapid knowledge checks to simulated exam conditions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 items-stretch">
        {/* Mode 1: High-Yield Filter */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-indigo-wash text-indigo flex items-center justify-center font-bold text-sm border border-indigo/20 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Learn</h3>
            <p class="text-xs text-slate leading-relaxed">
              Untimed practice with the full rationale shown after every answer.
            </p>
          </div>
        </Card>

        {/* Mode 2: Weak-Area Focus */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-700 flex items-center justify-center font-bold text-sm border border-rose-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Timed</h3>
            <p class="text-xs text-slate leading-relaxed">
              Simulated exam conditions with a countdown timer and rationales shown at the end.
            </p>
          </div>
        </Card>

        {/* Mode 3: Untested First */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-sm border border-teal-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Smart Mix</h3>
            <p class="text-xs text-slate leading-relaxed">
              A balanced session AcePharm selects from your weak and unseen questions.
            </p>
          </div>
        </Card>

        {/* Mode 4: Spaced Repetition Drill */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center font-bold text-sm border border-purple-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Weak Areas</h3>
            <p class="text-xs text-slate leading-relaxed">
              Automatically targets the topics where your first-attempt accuracy is lowest.
            </p>
          </div>
        </Card>

        {/* Mode 5: Timed Exam Condition */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-amber-light text-amber flex items-center justify-center font-bold text-sm border border-amber/20 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Unseen Questions</h3>
            <p class="text-xs text-slate leading-relaxed">
              Work through questions you have not attempted before, ahead of repeated practice.
            </p>
          </div>
        </Card>

        {/* Mode 6: Rapid-Fire Revision */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-700 flex items-center justify-center font-bold text-sm border border-sky-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Bookmarks</h3>
            <p class="text-xs text-slate leading-relaxed">
              Revisit the questions and notes you have saved for later.
            </p>
          </div>
        </Card>

        {/* Mode 7: High-Risk Drug Drill */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-700 flex items-center justify-center font-bold text-sm border border-rose-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Incorrect Questions</h3>
            <p class="text-xs text-slate leading-relaxed">
              Retry only the questions you previously answered incorrectly.
            </p>
          </div>
        </Card>

        {/* Mode 8: OTC Consultation Simulator */}
        <Card className="p-5 bg-surface border border-border hover:border-indigo/50 hover:shadow-xs transition-all rounded-card flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-sm border border-emerald-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Custom Session</h3>
            <p class="text-xs text-slate leading-relaxed">
              Choose your own topics, question types and session length.
            </p>
          </div>
        </Card>
      </div>

      <div class="text-center mt-10">
        <a href="https://app.acepharmexams.co.uk/demo/question">
          <Button variant="primary" size="lg">Try a sample question</Button>
        </a>
      </div>
    </div>

    {/* Bottom CTA & Disclaimers (AP-19: Differentiated CTAs) */}
    <div class="text-center pt-8 border-t border-border space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="https://app.acepharmexams.co.uk/auth/register">
          <Button size="lg" variant="primary">Start revising free</Button>
        </a>
        <a href="/question-bank#modes">
          <Button size="lg" variant="outline">Explore study modes</Button>
        </a>
      </div>
      <p class="text-xs text-slate-light">No card required. Upgrade only when you are ready.</p>
      <p class="text-[11px] text-slate-light max-w-2xl mx-auto leading-relaxed pt-2">
        AcePharm is not affiliated with or endorsed by examination bodies unless explicitly stated. Practice content is designed for education and cannot guarantee a particular examination result.
      </p>
    </div>
  </section>
</BaseLayout>
