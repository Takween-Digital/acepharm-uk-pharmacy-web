---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Card } from '@acepharm/ui';
import InteractiveSampleQuestion from '../components/InteractiveSampleQuestion';
---

<BaseLayout 
  title="AcePharm — Pharmacy revision that shows you exactly what to study next."
  description="AcePharm brings pharmacy-specific questions, clear explanations and progress analytics into one focused platform designed for UK pharmacy students."
>
  {/* 2.2 Hero Section */}
  <section class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/60 via-canvas to-canvas border-b border-border" style="background-image: url('/assets/backgrounds/hero-gradient.svg'); background-size: cover; background-position: center;">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Created by pharmacists. Built for pharmacy students.
        </span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink max-w-4xl mx-auto leading-tight">
        Pharmacy revision that shows you exactly what to study next.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        AcePharm brings pharmacy-specific questions, clear explanations and progress analytics into one focused platform designed for UK pharmacy students.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a href="https://app.acepharmexams.co.uk/auth/register">
          <Button size="lg" variant="primary">Start revising free</Button>
        </a>
        <a href="/features">
          <Button size="lg" variant="outline">Explore the platform</Button>
        </a>
      </div>
      
      <p class="mt-3 text-xs text-slate-light">
        No card required. Upgrade only when you are ready.
      </p>
      <p class="mt-6 text-xs font-medium text-slate uppercase tracking-wider">
        Built for MPharm students and the next generation of pharmacists.
      </p>

      {/* Interactive Micro-Demo Practice Island */}
      <div class="mt-12">
        <InteractiveSampleQuestion client:visible />
      </div>
    </div>
  </section>

  {/* 2.3 Trust Strip */}
  <section class="py-12 bg-canvas border-b border-border" style="background-image: url('/assets/backgrounds/trust-strip.svg'); background-size: cover; background-position: center;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-xs font-bold uppercase tracking-widest text-indigo mb-8">
        Trusted revision. Evidence-led learning.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {/* Item 1 */}
        <div class="p-5 bg-surface rounded-card border border-border hover:border-indigo/40 transition-all shadow-xs flex flex-col justify-between space-y-3 group">
          <div class="w-9 h-9 rounded-lg bg-indigo-wash text-indigo flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm font-bold text-ink">Pharmacy-specific</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              Designed around UK pharmacy education and practice.
            </p>
          </div>
        </div>

        {/* Item 2 */}
        <div class="p-5 bg-surface rounded-card border border-border hover:border-indigo/40 transition-all shadow-xs flex flex-col justify-between space-y-3 group">
          <div class="w-9 h-9 rounded-lg bg-teal-light text-teal flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm font-bold text-ink">Reviewed content</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              Questions and explanations reviewed through a defined editorial process.
            </p>
          </div>
        </div>

        {/* Item 3 */}
        <div class="p-5 bg-surface rounded-card border border-border hover:border-indigo/40 transition-all shadow-xs flex flex-col justify-between space-y-3 group">
          <div class="w-9 h-9 rounded-lg bg-indigo-wash text-indigo flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm font-bold text-ink">Clear references</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              See the evidence and guidance supporting key learning points.
            </p>
          </div>
        </div>

        {/* Item 4 */}
        <div class="p-5 bg-surface rounded-card border border-border hover:border-indigo/40 transition-all shadow-xs flex flex-col justify-between space-y-3 group">
          <div class="w-9 h-9 rounded-lg bg-amber-light text-amber flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm font-bold text-ink">Built for progress</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              Recommendations that tell you what to revise next.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 2.4 Problem Section */}
  <section class="py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" style="background-image: url('/assets/backgrounds/problem-section.svg'); background-size: cover; background-position: center;">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="px-3.5 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold uppercase tracking-wider border border-rose-200">
        THE REVISION PROBLEM
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mt-4">
        Most pharmacy revision tools were built for medicine. Or for 2018.
      </h2>
      <p class="mt-4 text-base text-slate leading-relaxed">
        Pharmacy students often have plenty of material but no clear way to decide what deserves attention. Notes become scattered, question banks show percentages without explaining what to do next, and revision plans quickly fall behind.
      </p>
      <p class="mt-2 text-base font-semibold text-indigo">
        AcePharm brings the important parts together, so every session has a purpose.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {/* Card 1 */}
      <Card className="p-7 bg-surface border border-border hover:border-indigo/40 transition-all rounded-card shadow-xs flex flex-col justify-between space-y-4 group">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-base border border-rose-200/60 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-ink leading-snug">
            “Generic question banks don’t reflect the GPhC assessment.”
          </h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed">
            Medical question banks test theoretical pathophysiology, not the MEP legal frameworks, OTC counter triage, and BNF high-risk drug monitoring essential for UK pharmacy registration.
          </p>
        </div>
        <div class="pt-3 border-t border-border/60 text-xs font-semibold text-rose-600 flex items-center gap-1">
          <span>Targeted to UK Blueprint</span>
        </div>
      </Card>

      {/* Card 2 */}
      <Card className="p-7 bg-surface border border-border hover:border-indigo/40 transition-all rounded-card shadow-xs flex flex-col justify-between space-y-4 group">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-light text-amber flex items-center justify-center font-bold text-base border border-amber/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-ink leading-snug">
            “Calculation practice that doesn’t show you where you went wrong.”
          </h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed">
            Getting a numerical problem wrong without detailed working leaves you guessing whether your error was a dilution factor, a unit conversion, or a premature decimal rounding mistake.
          </p>
        </div>
        <div class="pt-3 border-t border-border/60 text-xs font-semibold text-amber flex items-center gap-1">
          <span>Line-by-line formula working</span>
        </div>
      </Card>

      {/* Card 3 */}
      <Card className="p-7 bg-surface border border-border hover:border-indigo/40 transition-all rounded-card shadow-xs flex flex-col justify-between space-y-4 group">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-wash text-indigo flex items-center justify-center font-bold text-base border border-indigo/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-ink leading-snug">
            “No way to ask ‘why is this the answer?’ at 11 pm.”
          </h3>
          <p class="text-xs sm:text-sm text-slate leading-relaxed">
            When a guideline rationale doesn’t click during late-night revision, you shouldn’t have to post on student forums and wait days for an answer. Ace explains the clinical nuance immediately.
          </p>
        </div>
        <div class="pt-3 border-t border-border/60 text-xs font-semibold text-indigo flex items-center gap-1">
          <span>Instant 24/7 guideline tutoring</span>
        </div>
      </Card>
    </div>
  </section>

  {/* 2.5 Learning Loop */}
  <section class="py-20 bg-canvas border-y border-border" style="background-image: url('/assets/backgrounds/learning-loop.svg'); background-size: cover; background-position: center;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">More than a question bank</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mt-2">A complete learning loop.</h2>
        <p class="text-sm text-slate mt-2">Every answer should help make the next study decision easier.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {/* Stage 1 */}
        <div class="p-6 bg-surface rounded-card border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-4 group">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-xl bg-indigo-wash text-indigo font-bold flex items-center justify-center text-sm border border-indigo/20 group-hover:scale-105 transition-transform">
                1
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-light">Stage 01</span>
            </div>
            <h3 class="font-bold text-ink text-lg tracking-tight">Practise</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              High-yield clinical scenarios aligned with GPhC assessment weightings.
            </p>
          </div>
          <div class="pt-3 border-t border-border/50 text-xs font-semibold text-indigo flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            <span>Single best answer & calcs</span>
          </div>
        </div>

        {/* Stage 2 */}
        <div class="p-6 bg-surface rounded-card border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-4 group">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-xl bg-teal-50 text-teal-700 font-bold flex items-center justify-center text-sm border border-teal-200/60 group-hover:scale-105 transition-transform">
                2
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-light">Stage 02</span>
            </div>
            <h3 class="font-bold text-ink text-lg tracking-tight">Understand</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              Thorough clinical rationales citing NICE guidelines and BNF chapters for every option.
            </p>
          </div>
          <div class="pt-3 border-t border-border/50 text-xs font-semibold text-teal-700 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>NICE & BNF citations</span>
          </div>
        </div>

        {/* Stage 3 */}
        <div class="p-6 bg-surface rounded-card border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-4 group">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-xl bg-purple-50 text-purple-700 font-bold flex items-center justify-center text-sm border border-purple-200/60 group-hover:scale-105 transition-transform">
                3
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-light">Stage 03</span>
            </div>
            <h3 class="font-bold text-ink text-lg tracking-tight">Ask Ace</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              Grounded clinical AI tutoring when you need an explanation broken down further.
            </p>
          </div>
          <div class="pt-3 border-t border-border/50 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <span>Step-by-step breakdown</span>
          </div>
        </div>

        {/* Stage 4 */}
        <div class="p-6 bg-surface rounded-card border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-4 group">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-700 font-bold flex items-center justify-center text-sm border border-emerald-200/60 group-hover:scale-105 transition-transform">
                4
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-light">Stage 04</span>
            </div>
            <h3 class="font-bold text-ink text-lg tracking-tight">Retain</h3>
            <p class="text-xs sm:text-sm text-slate leading-relaxed">
              Spaced repetition and targeted re-testing that surfaces weak areas before exam day.
            </p>
          </div>
          <div class="pt-3 border-t border-border/50 text-xs font-semibold text-emerald-700 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Spaced re-testing loop</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 2.6 Question Experience */}
  <section class="py-20 max-w-5xl mx-auto px-4" style="background-image: url('/assets/backgrounds/question-experience.svg'); background-size: cover; background-position: center;">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl font-bold text-ink">Questions designed to teach, not merely test.</h2>
      <p class="mt-4 text-base text-slate leading-relaxed">
        Work through focused practice or timed sessions. Rate your confidence before submitting, compare your reasoning with the explanation, and revisit difficult questions when you need to.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        {['Single best answer', 'Pharmacy calculations', 'Timed or untimed', 'Confidence rating', 'Bookmark and notes', 'Question flagging', 'Keyboard shortcuts', 'Detailed answer review', 'Referenced learning points'].map((feat) => (
          <span class="px-3 py-1 bg-surface border border-border rounded-full text-xs font-semibold text-slate shadow-xs">{feat}</span>
        ))}
      </div>
      <div class="mt-8">
        <a href="https://app.acepharmexams.co.uk/auth/register">
          <Button variant="primary">Try a sample question</Button>
        </a>
      </div>
    </div>
  </section>

  {/* 2.8 Analytics Section */}
  <section class="py-20 bg-surface border-y border-border" style="background-image: url('/assets/backgrounds/analytics.svg'); background-size: cover; background-position: center;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Progress you can use</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mt-2">See more than a percentage.</h2>
        <p class="mt-4 text-base text-slate leading-relaxed">
          AcePharm looks at your topic performance, first-attempt accuracy, confidence, speed and revision history. It then turns those patterns into practical next steps.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {/* Card 1: Topic mastery */}
        <Card className="p-6 bg-canvas border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-indigo-wash text-indigo flex items-center justify-center font-bold text-sm border border-indigo/20 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Topic mastery</h3>
            <p class="text-xs text-slate leading-relaxed">
              See which areas are developing and which need another focused session.
            </p>
          </div>
        </Card>

        {/* Card 2: Confidence calibration */}
        <Card className="p-6 bg-canvas border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-sm border border-teal-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Confidence calibration</h3>
            <p class="text-xs text-slate leading-relaxed">
              Find topics where you feel certain but frequently select the wrong answer.
            </p>
          </div>
        </Card>

        {/* Card 3: Coverage */}
        <Card className="p-6 bg-canvas border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center font-bold text-sm border border-purple-200/60 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-ink text-base">Coverage</h3>
            <p class="text-xs text-slate leading-relaxed">
              Understand how much of your selected curriculum you have practised.
            </p>
          </div>
        </Card>

        {/* Card 4: Weekly direction */}
        <Card className="p-6 bg-canvas border border-border hover:border-indigo/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3 group">
          <div class="space-y-2">
